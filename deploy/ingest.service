[Unit]
Description=CV Web — ingesta del vault público (RAG)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cvweb
Group=cvweb
WorkingDirectory=/opt/cvweb/repo/backend
EnvironmentFile=/opt/cvweb/.env
ExecStart=/opt/cvweb/venv/bin/python scripts/ingest_public_vault.py --manifest /opt/cvweb/data/ingest_manifest.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cvweb/data
UMask=0077
