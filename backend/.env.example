# =============================================================================
# Rafita / CV Web — plantilla de configuración del backend
# Copia este fichero a `.env` (backend/.env en local, /opt/cvweb/.env o el
# `.env` del compose en el nodo) y rellena los secretos.
# El .env real está ignorado por git: NUNCA lo subas al repositorio.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
APP_ENV=development                          # development | production | test
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # vacío = same-origin
ALLOWED_HOSTS=*                              # en producción: cv-web.home,tu-dominio

# --- Router LLM (torre GPU → nodo Dell) --------------------------------------
# La torre (rafael-server) sirve `gemma4:12b` por Tailscale en el puerto 11435;
# el nodo Dell sirve el mismo modelo más lento. El router salta al siguiente
# proveedor si el primero está apagado o no responde antes del primer token.
LLM_PROVIDERS_ORDER=tower,dell
LLM_TOWER_URL=http://<torre-tailscale>:11435
LLM_TOWER_MODEL=gemma4:12b
LLM_DELL_URL=http://<dell-tailscale>:11434
LLM_DELL_MODEL=gemma4:12b
LLM_CONNECT_TIMEOUT_S=2.0
LLM_HEALTH_TTL_S=10
LLM_FIRST_TOKEN_TIMEOUT_S=30
LLM_MAX_CONCURRENCY=2
GEMINI_ENABLED=false                         # red de seguridad opcional; requiere GOOGLE_API_KEY
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- RAG (embeddings siempre en el Dell con bge-m3) --------------------------
# VAULT_PATH apunta a la bóveda de Obsidian; solo se indexa Public/ + cv_public.
# En el contenedor del nodo se monta en /vault y el índice en /data/chroma.
VAULT_PATH=/ruta/a/tu/segundo-cerebro
PUBLIC_VAULT_DIR=Public
EMBED_URL=http://<dell-tailscale>:11434
EMBED_MODEL=bge-m3:latest
CHROMA_PATH=./data/chroma
DATA_PATH=./data
RAG_TOP_K=5
# 0,60 con codificación simétrica (la consulta se embebe con el mismo prefijo
# de corpus que los chunks). Calibrado en eval/reports/: recall 0,983 · rechazo
# fuera de dominio 1,000 · 0 fugas · 7/8 inyecciones rechazadas.
RAG_MIN_SCORE=0.60
RAG_CONTEXT_PREFIX=Rafael Castaño

# --- Seguridad y límites -----------------------------------------------------
TRUSTED_PROXY_IPS=127.0.0.1
MAX_BODY_BYTES=16384
MAX_MESSAGE_CHARS=500
MAX_HISTORY_TURNS=6
RATE_LIMIT_CHAT=10/minute;60/hour
RATE_LIMIT_CONTACT=3/hour
RATE_LIMIT_FEEDBACK=20/hour
DAILY_CHAT_BUDGET=500
PUBLIC_CONTACT_ALLOWLIST=rafaelcastanoblanca1805@gmail.com
ALLOWED_OUTPUT_DOMAINS=github.com,linkedin.com

# --- Contacto (SMTP; opcional) -----------------------------------------------
EMAIL=
PASSWORD_APPLICATION=
CONTACT_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_TIMEOUT_S=10
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=

# --- Operación ---------------------------------------------------------------
METRICS_TOKEN=
