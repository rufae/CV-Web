# =============================================================================
# CV Web — plantilla de configuración del backend
# Copia este fichero a `backend/.env` y rellena los valores.
# El .env real está ignorado por git: NUNCA lo subas al repositorio.
# =============================================================================

# --- Aplicación (usadas hoy) -------------------------------------------------
APP_ENV=development                          # development | production
ALLOWED_ORIGINS=http://localhost:5173        # lista separada por comas; vacío = same-origin
RAFA_CONTEXT_PATH=/ruta/a/rafa_context.txt   # fuera del repo (docs/adr/0006); en dev basta backend/rafa_context.txt
GEMINI_MODEL=gemini-2.5-flash

# --- Chat / Gemini (usadas hoy) ----------------------------------------------
GOOGLE_API_KEY=

# --- Contacto (usadas hoy) ----------------------------------------------------
EMAIL=
PASSWORD_APPLICATION=

# --- Reservadas para Fases 2-7: el código aún NO las lee ----------------------
# LLM router (F2)
LLM_PROVIDERS_ORDER=tower,dell
LLM_TOWER_URL=http://torre-tailscale:11434
LLM_TOWER_MODEL=modelo-grande
LLM_DELL_URL=http://dell-tailscale:11434
LLM_DELL_MODEL=modelo-24x7
LLM_HEALTH_TTL_S=10
LLM_CONNECT_TIMEOUT_S=1.5
LLM_FIRST_TOKEN_TIMEOUT_S=15
GEMINI_ENABLED=false

# RAG (F3)
EMBED_URL=http://dell-tailscale:11434
EMBED_MODEL=bge-m3
CHROMA_PATH=/opt/cvweb/data/chroma
RAG_TOP_K=5
RAG_MIN_SCORE=0.45
VAULT_PATH=/ruta/al/segundo-cerebro

# Seguridad y límites (F4)
ALLOWED_HOSTS=tu-dominio.example,localhost
TRUSTED_PROXY_IPS=127.0.0.1
MAX_BODY_BYTES=16384
MAX_MESSAGE_CHARS=500
MAX_HISTORY_TURNS=6
RATE_LIMIT_CHAT=10/minute;60/hour
RATE_LIMIT_CONTACT=3/hour
RATE_LIMIT_FEEDBACK=20/hour
DAILY_CHAT_BUDGET=500
PROMPT_VERSION=v1
PUBLIC_CONTACT_ALLOWLIST=
DATA_PATH=/opt/cvweb/data

# Contacto futuro (F4)
CONTACT_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT_S=10
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=

# Operación (F7)
METRICS_TOKEN=
