# Configuración del frontend (Vite). Copia a `.env.local` si la necesitas.

# URL de la API si vive en otro origen (vacío = mismo origen, lo normal).
VITE_API_URL=

# Destino del backend en desarrollo (npm run dev). Por defecto
# http://127.0.0.1:8000 (backend local del runbook). Para probar contra el
# desplegado: VITE_DEV_API_TARGET=http://<nodo>:8086 npm run dev
VITE_DEV_API_TARGET=

# Modelo que muestra la insignia de proveedor del chat (informativo).
VITE_LLM_MODEL=gemma4:12b
